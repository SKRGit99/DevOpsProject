  "components": {
    "schemas": {
      "SyncResult": {
        "type": "object",
        "properties": {
          "totalFetched": {
            "type": "integer",
            "format": "int32"
          },
          "totalSynced": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
