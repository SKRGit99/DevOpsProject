      "post": {
        "tags": [
          "Sync"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResult"
                }
              }
            }
          }
        }
      }
    }
